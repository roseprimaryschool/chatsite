# GEMINI_API_KEY: Optional if AI capabilities are used
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this applet is hosted
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# NODE_ENV: development | production
NODE_ENV=development

# DATABASE_PATH: Path to LibSQL SQLite database file (defaults to data/pulsechat.db)
DATABASE_PATH="./data/pulsechat.db"
